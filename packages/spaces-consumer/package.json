{
  "name": "@coopsource/spaces-consumer",
  "version": "0.0.0",
  "private": true,
  "description": "Pull-based consumer over ATProto permissioned spaces (V11 Stage 1)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@atproto/crypto": "^0.4.5",
    "@atproto/lex-cbor": "^0.0.15",
    "@coopsource/common": "workspace:*",
    "@coopsource/db": "workspace:*",
    "@coopsource/lexicons": "workspace:*",
    "@ipld/car": "^5.4.2",
    "@ipld/dag-cbor": "^9.2.5",
    "@noble/hashes": "^1.8.0",
    "kysely": "^0.28.17",
    "multiformats": "^13.4.2"
  },
  "devDependencies": {
    "@coopsource/config": "workspace:*",
    "@types/node": "^25.3.2",
    "typescript": "^5.9",
    "vitest": "^4.0"
  }
}
