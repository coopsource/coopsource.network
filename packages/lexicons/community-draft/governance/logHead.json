{
  "lexicon": 1,
  "id": "community.lexicon.governance.logHead",
  "defs": {
    "main": {
      "type": "record",
      "description": "Draft signed tree head for an append-only governance transparency log.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "authorityDid",
          "spaceKey",
          "treeSize",
          "rootHash",
          "hashAlgorithm",
          "signature",
          "signedAt"
        ],
        "properties": {
          "authorityDid": { "type": "string", "format": "did" },
          "spaceKey": { "type": "string", "maxLength": 512 },
          "treeSize": { "type": "integer", "minimum": 0 },
          "rootHash": {
            "type": "string",
            "maxLength": 512,
            "description": "Multibase or application-agreed encoding of the tree root."
          },
          "hashAlgorithm": { "type": "string", "maxLength": 64 },
          "signature": {
            "type": "string",
            "maxLength": 2048,
            "description": "Encoded signature over the tree-head payload."
          },
          "previousHead": { "type": "string", "format": "at-uri" },
          "signedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
