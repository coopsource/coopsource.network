{
  "lexicon": 1,
  "id": "community.lexicon.governance.vote",
  "defs": {
    "main": {
      "type": "record",
      "description": "Draft generic vote on a governance proposal.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["proposalUri", "voterDid", "choice", "createdAt"],
        "properties": {
          "proposalUri": { "type": "string", "format": "at-uri" },
          "voterDid": { "type": "string", "format": "did" },
          "choice": { "type": "string", "maxLength": 1000 },
          "rationale": { "type": "string", "maxLength": 2000 },
          "weight": {
            "type": "ref",
            "ref": "#weight",
            "description": "Resolved rational voting weight snapshot; defaults to one when absent."
          },
          "weightEvidenceUri": {
            "type": "string",
            "format": "at-uri",
            "description": "Optional application-specific evidence for the weight snapshot."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "weight": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
