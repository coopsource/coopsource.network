{
  "lexicon": 1,
  "id": "community.lexicon.governance.deliberation",
  "defs": {
    "main": {
      "type": "record",
      "description": "Draft generic deliberation entry attached to a governance proposal.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["proposalUri", "authorDid", "body", "createdAt"],
        "properties": {
          "proposalUri": { "type": "string", "format": "at-uri" },
          "authorDid": { "type": "string", "format": "did" },
          "body": { "type": "string", "maxLength": 10000 },
          "replyTo": { "type": "string", "format": "at-uri" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
