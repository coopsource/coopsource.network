{
  "lexicon": 1,
  "id": "community.lexicon.governance.election",
  "defs": {
    "main": {
      "type": "record",
      "description": "Draft generic election for filling a group position.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "authorityDid",
          "spaceKey",
          "proposerDid",
          "title",
          "position",
          "candidates",
          "status",
          "createdAt"
        ],
        "properties": {
          "authorityDid": { "type": "string", "format": "did" },
          "spaceKey": { "type": "string", "maxLength": 512 },
          "proposerDid": { "type": "string", "format": "did" },
          "title": { "type": "string", "maxLength": 256 },
          "summary": { "type": "string", "maxLength": 2000 },
          "position": { "type": "string", "maxLength": 256 },
          "candidates": {
            "type": "array",
            "minLength": 1,
            "maxLength": 100,
            "items": { "type": "ref", "ref": "#candidate" }
          },
          "votingStartsAt": { "type": "string", "format": "datetime" },
          "votingEndsAt": { "type": "string", "format": "datetime" },
          "status": {
            "type": "string",
            "knownValues": ["draft", "open", "closed", "resolved", "withdrawn"]
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 256 },
        "actorDid": { "type": "string", "format": "did" }
      }
    }
  }
}
