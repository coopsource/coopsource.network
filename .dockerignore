# Dependencies (installed fresh inside container)
# `**/`-prefixed so these match at every depth: a bare `node_modules/` or
# `dist/` is root-anchored, which let workspace artifacts such as
# packages/common/dist ship from the host and mask in-image build gaps.
**/node_modules

# Build outputs (rebuilt inside container)
**/dist
**/.svelte-kit
**/.turbo

# Environment files (secrets)
.env
.env.*
!.env.example

# Git
.git/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage/
playwright-report/
test-results/

# Data
data/

# Docker
infrastructure/pgdata/

# Worktrees
.worktrees/

# Documentation (not needed at build time)
*.md
docs/
LICENSE
