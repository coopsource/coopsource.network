{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".svelte-kit/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "PGUSER",
        "PGPASSWORD"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {},
    "clean": {
      "cache": false
    },
    "lex:generate": {
      "outputs": [
        "packages/lexicons/generated/**"
      ]
    }
  }
}
